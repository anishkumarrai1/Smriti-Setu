# Production & Development Environment Configuration for Smriti-Setu
PORT=5000
NODE_ENV=development

# Database Connection URL (Supports MongoDB / PostgreSQL / File Store)
DATABASE_URL=mongodb://localhost:27017/smriti_setu

# JWT Session Encryption Secret
JWT_SECRET=smriti_setu_secure_jwt_secret_key_2026_ner_healthcare_portal!

# Initial Super Admin Seed Account
INITIAL_ADMIN_EMAIL=admin@smritisetu.gov.in
INITIAL_ADMIN_PASSWORD=Admin12!
INITIAL_ADMIN_NAME=NHA Regional Administrator

# Real Email OTP Provider Credentials (e.g. Resend / SendGrid / Nodemailer SMTP)
EMAIL_SERVICE_API_KEY=your_production_email_api_key_here
EMAIL_FROM_ADDRESS=noreply@smritisetu.gov.in

# Real SMS OTP Provider Credentials (e.g. Twilio / Fast2SMS / MSG91)
SMS_SERVICE_API_KEY=your_production_sms_api_key_here
SMS_SENDER_ID=SMRITI

# Server-Verified CAPTCHA Credentials (e.g. Cloudflare Turnstile / reCAPTCHA)
CAPTCHA_SECRET_KEY=your_cloudflare_turnstile_secret_key
CAPTCHA_SITE_KEY=your_cloudflare_turnstile_site_key
